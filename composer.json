{
  "name": "sugarcommerce/paginate",
  "version": "1.0.1",
  "description": "Paging, sorting and search for list screens, with the column names allow-listed because they cannot be bound as parameters. Returns a page object that knows how to render its own controls.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarcommerce/paginate",
  "authors": [ { "name": "David Sherlock", "homepage": "https://arraypress.com/" } ],
  "keywords": ["pagination", "sorting", "search", "sqlite", "admin"],
  "require": {
    "php": ">=8.5",
    "sugarcommerce/sqlite": "^1.0",
    "sugarcommerce/sanitize": "^1.0"
  },
  "require-dev": { "phpunit/phpunit": "^13.0" },
  "autoload": { "psr-4": { "SugarCommerce\\Paginate\\": "src/" } },
  "autoload-dev": { "psr-4": { "SugarCommerce\\Paginate\\Tests\\": "tests/" } },
  "repositories": [ { "type": "path", "url": "../*", "options": { "symlink": true } } ],
  "scripts": { "test": "phpunit" },
  "config": { "optimize-autoloader": true, "sort-packages": true, "preferred-install": "dist" },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": { "issues": "https://github.com/sugarcommerce/paginate/issues", "source": "https://github.com/sugarcommerce/paginate" }
}
